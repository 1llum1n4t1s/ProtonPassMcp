{
  "name": "@kagayoi/proton-pass-mcp",
  "version": "1.0.10",
  "description": "Read-only MCP server for an existing Proton Pass CLI session",
  "license": "MIT",
  "bin": {
    "proton-pass-mcp": "src/cli.mjs"
  },
  "files": ["src/", "CHANGELOG.md"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1llum1n4t1s/ProtonPassMcp.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "scripts": {
    "start": "bun --no-env-file --no-install src/cli.mjs",
    "start:node": "node src/cli.mjs",
    "test": "bun --no-env-file --no-install test ./test",
    "test:node": "node --test test/*.test.mjs",
    "verify": "bun --no-env-file --no-install scripts/verify.mjs",
    "verify:node": "node scripts/verify.mjs",
    "prepublishOnly": "bun --no-env-file --no-install run test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
